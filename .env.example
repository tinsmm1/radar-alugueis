# Set private values in the ignored .env.local (locally) or in Vercel → Settings → Environment Variables.
# Never use NEXT_PUBLIC_* for secrets. Everything except the database is optional.

# Postgres with PostGIS (Neon on Vercel creates DATABASE_URL/POSTGRES_URL by itself).
DATABASE_URL=
# Optional direct (non-pooled) connection for migrations.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info

# Access: without APP_PASSWORD the owner creates the password on the first visit.
APP_PASSWORD=
AUTH_SECRET=

# Scheduler: same value in Vercel and in GitHub → Settings → Secrets → Actions.
CRON_SECRET=

# Notifications (choose any; without them notifications stay in the app).
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=
NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public address for links in notifications (falls back to the Vercel production URL).
APP_URL=
# Contact e-mail for the geocoder's User-Agent (Nominatim usage policy).
GEOCODER_CONTACT=

# Optional: Apify token (console.apify.com → Settings → API & Integrations) to read portal scraper tasks.
# Opt-in by the owner; portal terms forbid automated collection (see docs/fontes.md).
APIFY_TOKEN=

# Optional: TomTom Routing API key (developer.tomtom.com, free 2,500 requests/day). Car, bike and walking
# commutes then use historic traffic at the owner's own times (Administração → Perfil e trabalho).
TOMTOM_API_KEY=
# Optional: max TomTom requests per day used by the Radar (default 2000).
TOMTOM_DAILY_BUDGET=
