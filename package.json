{
  "name": "radar-alugueis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3700",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "start": "next start -p 3700",
    "lint": "eslint .",
    "lint:typed": "eslint --config eslint.typed.config.mjs .",
    "lint:rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:typed && pnpm lint:rules && pnpm test && pnpm build"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@next/env": "16.4.6",
    "@vercel/functions": "3.10.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.64.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "10.3.1",
    "pbf": "5.1.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pngjs": "7.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-drizzle": "0.2.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
